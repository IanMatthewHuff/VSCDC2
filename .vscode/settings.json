{
  "vitest.exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "packages/extension/src/test/**"
  ],
  "vitest.include": [
    "packages/engine/**/*.test.ts",
    "packages/game/**/*.test.ts",
