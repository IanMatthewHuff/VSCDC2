{
  "name": "vscdc-extension",
  "displayName": "VS Code Dungeon Crawler",
  "description": "A turn-based roguelike dungeon crawler game for VS Code",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscdc.startGame",
        "title": "Start Game",
        "category": "Dungeon Crawler"
      },
      {
        "command": "vscdc.startGameNoEnemies",
        "title": "Start Game (No Enemies)",
        "category": "Dungeon Crawler"
      },
      {
        "command": "vscdc.moveUp",
        "title": "Move Up",
        "category": "Dungeon Crawler"
      },
      {
        "command": "vscdc.moveDown",
        "title": "Move Down",
        "category": "Dungeon Crawler"
      },
      {
        "command": "vscdc.moveLeft",
        "title": "Move Left",
        "category": "Dungeon Crawler"
      },
      {
        "command": "vscdc.moveRight",
        "title": "Move Right",
        "category": "Dungeon Crawler"
      },
      {
        "command": "vscdc.useConsumable0",
        "title": "Use",
        "category": "Dungeon Crawler"
      },
      {
        "command": "vscdc.useConsumable1",
        "title": "Use",
        "category": "Dungeon Crawler"
      },
      {
        "command": "vscdc.useConsumable2",
        "title": "Use",
        "category": "Dungeon Crawler"
      },
      {
        "command": "vscdc.removeConsumable0",
        "title": "Remove Consumable Slot 1",
        "category": "Dungeon Crawler",
        "icon": "$(trash)"
      },
      {
        "command": "vscdc.removeConsumable1",
        "title": "Remove Consumable Slot 2",
        "category": "Dungeon Crawler",
        "icon": "$(trash)"
      },
      {
        "command": "vscdc.removeConsumable2",
        "title": "Remove Consumable Slot 3",
        "category": "Dungeon Crawler",
        "icon": "$(trash)"
      },
      {
        "command": "vscdc.equipItem",
        "title": "Equip",
        "category": "Dungeon Crawler",
        "icon": "$(arrow-up)"
      },
      {
        "command": "vscdc.equipToConsumableSlot",
        "title": "Equip to Slot",
        "category": "Dungeon Crawler",
        "icon": "$(arrow-up)"
      },
      {
        "command": "vscdc.dropItem",
        "title": "Drop",
        "category": "Dungeon Crawler",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "vscdc.moveUp",
        "key": "w",
        "when": "vscdc.gameActive && editorTextFocus"
      },
      {
        "command": "vscdc.moveUp",
        "key": "up",
        "when": "vscdc.gameActive && editorTextFocus"
      },
      {
        "command": "vscdc.moveDown",
        "key": "s",
        "when": "vscdc.gameActive && editorTextFocus"
      },
      {
        "command": "vscdc.moveDown",
        "key": "down",
        "when": "vscdc.gameActive && editorTextFocus"
      },
      {
        "command": "vscdc.moveLeft",
        "key": "a",
        "when": "vscdc.gameActive && editorTextFocus"
      },
      {
        "command": "vscdc.moveLeft",
        "key": "left",
        "when": "vscdc.gameActive && editorTextFocus"
      },
      {
        "command": "vscdc.moveRight",
        "key": "d",
        "when": "vscdc.gameActive && editorTextFocus"
      },
      {
        "command": "vscdc.moveRight",
        "key": "right",
        "when": "vscdc.gameActive && editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscdc-game",
          "title": "Dungeon Crawler",
          "icon": "$(target)"
        }
      ]
    },
    "views": {
      "vscdc-game": [
        {
          "id": "vscdc.playerView",
          "name": "Player",
          "when": "vscdc.gameActive"
        },
        {
          "id": "vscdc.equipmentView",
          "name": "Equipment",
          "when": "vscdc.gameActive"
        },
        {
          "id": "vscdc.inventoryView",
          "name": "Inventory",
          "when": "vscdc.gameActive"
        },
        {
          "id": "vscdc.cursorLocationView",
          "name": "Current Location",
          "when": "vscdc.gameActive"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "vscdc.useConsumable0",
          "when": "view == vscdc.equipmentView && viewItem == consumableSlot0",
          "group": "inline@1"
        },
        {
          "command": "vscdc.removeConsumable0",
          "when": "view == vscdc.equipmentView && viewItem == consumableSlot0",
          "group": "inline@2"
        },
        {
          "command": "vscdc.useConsumable1",
          "when": "view == vscdc.equipmentView && viewItem == consumableSlot1",
          "group": "inline@1"
        },
        {
          "command": "vscdc.removeConsumable1",
          "when": "view == vscdc.equipmentView && viewItem == consumableSlot1",
          "group": "inline@2"
        },
        {
          "command": "vscdc.useConsumable2",
          "when": "view == vscdc.equipmentView && viewItem == consumableSlot2",
          "group": "inline@1"
        },
        {
          "command": "vscdc.removeConsumable2",
          "when": "view == vscdc.equipmentView && viewItem == consumableSlot2",
          "group": "inline@2"
        },
        {
          "command": "vscdc.equipItem",
          "when": "view == vscdc.inventoryView && viewItem =~ /^inventoryEquipment_/",
          "group": "inline@1"
        },
        {
          "command": "vscdc.equipToConsumableSlot",
          "when": "view == vscdc.inventoryView && viewItem == inventoryConsumable",
          "group": "inline@1"
        },
        {
          "command": "vscdc.dropItem",
          "when": "view == vscdc.inventoryView && viewItem =~ /^inventory(Equipment|Consumable)/",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:web": "node esbuild.config.mjs --web",
    "build:all": "node esbuild.config.mjs --all",
    "clean": "rm -rf dist",
    "test": "vscode-test",
    "open-in-browser": "vscode-test-web --extensionDevelopmentPath=. --quality stable"
  },
  "dependencies": {
    "@vscdc/engine": "*",
    "@vscdc/game": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.62",
    "glob": "^13.0.0"
  }
}
